# Marque
APP_NAME=Stockpay
APP_CREDIT=Fait par webbap
APP_TAGLINE=hébergement & paiement sécurisé

# Sécurité (à changer avant prod)
SECRET_KEY=remplacez-par-une-cle-longue-et-aleatoire
STOCKPAY_ADMIN_PASSWORD=changez-moi

# PythonAnywhere : dossier parent des projets (aquaviva/, cle_corse/, …)
STOCKPAY_SCAN_ROOT=/home/VOTRE_USER

# URL publique HTTPS du site — à renseigner DÈS que le site est en ligne
# Ex. https://votreuser.pythonanywhere.com
PUBLIC_BASE_URL=

# Répartition du forfait PythonAnywhere
STOCKPAY_COST_DISK=4.00
STOCKPAY_COST_WEBAPP=3.50
STOCKPAY_COST_RAM=2.50
STOCKPAY_BILLING_PERCENT=100
STOCKPAY_REMINDER_COOLDOWN=7

# ─── Stripe : brancher APRÈS mise en ligne (mode Production) ───
# 1. Dashboard Stripe → Production → Clés API
# 2. Coller sk_live_… et pk_live_…
# 3. Webhooks → https://TON-DOMAINE/webhook/stripe
#    événement : checkout.session.completed → whsec_…
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_MANUAL=false

# Mentions factures
INVOICE_ISSUER_NAME=Stockpay
INVOICE_ISSUER_DETAILS=Fait par webbap · hébergement mutualisé PythonAnywhere
INVOICE_FOOTER=Document généré par Stockpay — Fait par webbap. TVA non applicable — à adapter selon votre situation.

# SMTP (optionnel — rappels e-mail)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
